{# `pattern` is an ILIKE pattern with %, _ and \ already escaped by the caller. #}
SELECT set_id, version_id, title, description, image_url_1x, image_url_2x, image_url_4x,
       click_url, first_seen_at, last_seen_at
FROM chat_badges
{% if pattern is not none %}
WHERE title ILIKE {{ pattern | bind }} ESCAPE '\'
{% endif %}
ORDER BY first_seen_at DESC, title
LIMIT {{ limit | bind }};
