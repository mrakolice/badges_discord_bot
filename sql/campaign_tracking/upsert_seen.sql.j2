{# xmax = 0 only for a freshly inserted row: tells "new campaign" from "already seen". #}
INSERT INTO campaigns_seen (campaign_id, campaign_type, data_json)
VALUES ({{ campaign_id | bind }}, {{ campaign_type | bind }}, {{ data | bind }})
ON CONFLICT (campaign_id, campaign_type) DO UPDATE
    SET data_json = EXCLUDED.data_json,
        last_seen_at = now()
RETURNING campaign_id, campaign_type, first_seen_at, last_seen_at, data_json,
          (xmax = 0) AS inserted;
