# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DEFAULT_NOTIFICATION_CHANNEL_ID=

# --- Twitch Helix / Sunkwi ---------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DROPS_API_KEY=

# --- Logic -------------------------------------------------------------------
CHECK_INTERVAL_MINUTES=5
STREAM_NOTIFY_COOLDOWN_HOURS=6

# --- Shared Postgres from the infra stack (docker-compose.infra.yml) ---------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Superuser credentials: used ONLY by the one-time `db-bootstrap` service.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=

# Bot database and roles. Passwords go into a URL: use URL-safe values,
# e.g. `openssl rand -hex 24`.
BOT_DB_NAME=twitch_badge_bot
BOT_DB_OWNER=twitch_bot_owner
BOT_DB_OWNER_PASSWORD=
BOT_DB_APP_USER=twitch_bot_app
BOT_DB_APP_PASSWORD=

# --- Infra integration -------------------------------------------------------
BACKEND_NETWORK=backend
PROXY_NETWORK=proxy
BOTS_HOSTNAME=
BOT_HTTP_PORT=8080
